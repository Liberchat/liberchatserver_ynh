#!/bin/bash

source /usr/share/yunohost/helpers
source _common.sh

#=================================================
# INSTALL DEPENDENCIES
#=================================================
ynh_script_progression --message="Installing dependencies..." --weight=7

# Install Node.js 20+ via NodeSource (required for some dependencies)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Verify Node.js version
node_version=$(node --version | cut -d'v' -f2 | cut -d'.' -f1)
if [ "$node_version" -lt 20 ]; then
    ynh_die --message="Node.js version 20+ is required, found version $node_version"
fi

# Install global dependencies needed for build
npm install -g patch-package

#=================================================
# DOWNLOAD AND EXTRACT SOURCE
#=================================================
ynh_script_progression --message="Setting up source files..." --weight=1

ynh_setup_source --dest_dir="$install_dir"

# Remove problematic files that might cause conflicts
rm -f "$install_dir/package-lock.json"
rm -rf "$install_dir/node_modules"

# Remove obsolete App.tsx that conflicts with src/components/App.tsx
rm -f "$install_dir/src/App.tsx"

# Fix main.tsx to import from components/App instead of ./App
if [ -f "$install_dir/src/main.tsx" ]; then
    sed -i "s|from './App'|from './components/App'|g" "$install_dir/src/main.tsx"
fi

# Fix permissions (YunoHost provisioning handles user creation)
chown -R $app:www-data "$install_dir" 2>/dev/null || true

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression --message="Adding system configurations..." --weight=1

ynh_add_nginx_config

ynh_add_systemd_config

yunohost service add $app --description="Liberchat chat application"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression --message="Adding app's configuration..." --weight=1

ynh_add_config --template="env" --destination="$install_dir/.env"
chmod 644 "$install_dir/.env"
chown $app:$app "$install_dir/.env"

#=================================================
# INSTALL APP
#=================================================
ynh_script_progression --message="Installing app..." --weight=10

pushd "$install_dir"
	# Clear npm cache to avoid conflicts
	ynh_exec_as $app npm cache clean --force
	
	# Set npm configuration for the app user
	ynh_exec_as $app npm config set fund false
	ynh_exec_as $app npm config set audit false
	ynh_exec_as $app npm config set update-notifier false
	
	# Make patch-package available in PATH for the app user
	export PATH="/usr/local/bin:$PATH"
	
	# Install dependencies with all necessary flags
	ynh_print_info "Installing npm dependencies..."
	if ! ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm install --production=false --legacy-peer-deps --no-audit --no-fund --ignore-engines; then
		ynh_die --message="Failed to install npm dependencies. Check Node.js version and dependencies."
	fi
	
	# Run postinstall scripts if needed
	if [ -f "package.json" ] && grep -q "postinstall" package.json; then
		ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm run postinstall
	fi
	
	# Build the application
	ynh_print_info "Building the application..."
	if ! ynh_exec_as $app env NODE_ENV=production YNH_APP_ARG_PATH="$path" PATH="/usr/local/bin:$PATH" npm run build; then
		ynh_die --message="Failed to build the application. Check build logs."
	fi
popd

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression --message="Starting a systemd service..." --weight=1

ynh_systemd_action --service_name=$app --action="start" --log_path="/var/log/$app/$app.log"



#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression --message="Installation of $app completed" --last