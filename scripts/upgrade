#!/bin/bash

source /usr/share/yunohost/helpers
source _common.sh

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression --message="Stopping a systemd service..." --weight=1

ynh_systemd_action --service_name=$app --action="stop" --log_path="/var/log/$app/$app.log"

#=================================================
# CLEAN PREVIOUS INSTALLATION
#=================================================
ynh_script_progression --message="Cleaning previous installation..." --weight=2

# Remove all node-related files to avoid conflicts
rm -rf "$install_dir/node_modules"
rm -f "$install_dir/package-lock.json"
rm -rf "$install_dir/.npm"
rm -rf "$install_dir/dist"
rm -rf "$install_dir/build"

# Clean npm cache for the app user
ynh_exec_as $app npm cache clean --force 2>/dev/null || true

#=================================================
# COPY LOCAL SOURCE FILES
#=================================================
ynh_script_progression --message="Upgrading source files..." --weight=1

# Backup .env
if [ -f "$install_dir/.env" ]; then
    cp "$install_dir/.env" "/tmp/liberchat_env_backup"
fi

# Copy all files from the YunoHost package directory to install_dir
cp -r "$YNH_APP_BASEDIR/"* "$install_dir/"
rm -rf "$install_dir/scripts" "$install_dir/conf" "$install_dir/manifest.toml" "$install_dir/.git" 2>/dev/null || true

# Restore .env
if [ -f "/tmp/liberchat_env_backup" ]; then
    mv "/tmp/liberchat_env_backup" "$install_dir/.env"
fi

# Fix permissions
chown -R $app:www-data "$install_dir" 2>/dev/null || true

#=================================================
# UPDATE CONFIGURATION
#=================================================
ynh_script_progression --message="Updating configuration..." --weight=1

# Backup custom variables from existing .env
if [ -f "$install_dir/.env" ]; then
    MAX_MESSAGES_OLD=$(grep "^MAX_MESSAGES=" "$install_dir/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '\n' || echo "")
    MAX_FILE_SIZE_OLD=$(grep "^MAX_FILE_SIZE=" "$install_dir/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '\n' || echo "")
    PING_TIMEOUT_OLD=$(grep "^PING_TIMEOUT=" "$install_dir/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '\n' || echo "")
    PING_INTERVAL_OLD=$(grep "^PING_INTERVAL=" "$install_dir/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '\n' || echo "")
fi

ynh_add_config --template="env" --destination="$install_dir/.env"
chmod 644 "$install_dir/.env"
chown $app:$app "$install_dir/.env"

# Restore custom variables if they existed and are different from defaults
if [ -n "$MAX_MESSAGES_OLD" ] && [ "$MAX_MESSAGES_OLD" != "100" ]; then
    sed -i "s/^MAX_MESSAGES=.*/MAX_MESSAGES=$MAX_MESSAGES_OLD/" "$install_dir/.env"
fi
if [ -n "$MAX_FILE_SIZE_OLD" ] && [ "$MAX_FILE_SIZE_OLD" != "50" ]; then
    sed -i "s/^MAX_FILE_SIZE=.*/MAX_FILE_SIZE=$MAX_FILE_SIZE_OLD/" "$install_dir/.env"
fi
if [ -n "$PING_TIMEOUT_OLD" ] && [ "$PING_TIMEOUT_OLD" != "60000" ]; then
    sed -i "s/^PING_TIMEOUT=.*/PING_TIMEOUT=$PING_TIMEOUT_OLD/" "$install_dir/.env"
fi
if [ -n "$PING_INTERVAL_OLD" ] && [ "$PING_INTERVAL_OLD" != "25000" ]; then
    sed -i "s/^PING_INTERVAL=.*/PING_INTERVAL=$PING_INTERVAL_OLD/" "$install_dir/.env"
fi

#=================================================
# UPDATE NODE.JS IF NEEDED
#=================================================
current_node_version=$(node --version | cut -d'v' -f2 | cut -d'.' -f1)
if [ "$current_node_version" -lt 20 ]; then
	ynh_script_progression --message="Updating Node.js to version 20..." --weight=5
	curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
	apt-get install -y nodejs
	
	# Verify the update worked
	new_node_version=$(node --version | cut -d'v' -f2 | cut -d'.' -f1)
	if [ "$new_node_version" -lt 20 ]; then
		ynh_die --message="Failed to update Node.js to version 20+. Current version: $(node --version)"
	fi
fi

# Install patch-package globally if not present
if ! command -v patch-package >/dev/null 2>&1; then
	ynh_script_progression --message="Installing patch-package..." --weight=1
	npm install -g patch-package
fi

#=================================================
# UPGRADE APP
#=================================================
ynh_script_progression --message="Upgrading app..." --weight=10

pushd "$install_dir"
	
	# Set npm configuration for the app user
	ynh_exec_as $app npm config set fund false
	ynh_exec_as $app npm config set audit false
	ynh_exec_as $app npm config set update-notifier false
	
	# Make patch-package available in PATH for the app user
	export PATH="/usr/local/bin:$PATH"
	
	# Install dependencies with all necessary flags
	ynh_print_info "Installing npm dependencies..."
	# Force clean install to fix ARM64 rollup issues
	if ! ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm ci --production=false --legacy-peer-deps --no-audit --no-fund --ignore-engines 2>/dev/null; then
		# Fallback to regular install if ci fails
		ynh_print_info "npm ci failed, trying npm install..."
		if ! ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm install --production=false --legacy-peer-deps --no-audit --no-fund --ignore-engines; then
			ynh_die --message="Failed to install npm dependencies. Check Node.js version and dependencies."
		fi
	fi
	
	# Verify critical dependencies are installed
	ynh_print_info "Verifying critical dependencies..."
	if ! ynh_exec_as $app npm list dotenv >/dev/null 2>&1; then
		ynh_print_info "dotenv missing, installing manually..."
		ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm install dotenv@^16.4.5
	fi
	
	# Run postinstall if needed
	if [ -f "package.json" ] && grep -q "postinstall" package.json; then
		ynh_exec_as $app env PATH="/usr/local/bin:$PATH" npm run postinstall
	fi
	
	# Build the application
	ynh_print_info "Building the application..."
	if ! ynh_exec_as $app env NODE_ENV=production YNH_APP_ARG_PATH="$path" PATH="/usr/local/bin:$PATH" npm run build; then
		ynh_die --message="Failed to build the application. Check build logs."
	fi
popd

#=================================================
# UPDATE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression --message="Updating system configurations..." --weight=1

ynh_add_nginx_config

ynh_add_systemd_config



#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression --message="Starting a systemd service..." --weight=1

ynh_systemd_action --service_name=$app --action="start" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression --message="Upgrade of $app completed" --last